FLASK_ENV=development
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false

# PostgreSQL local (la base SQLite existente se conserva como respaldo).
USE_POSTGRES=true
USE_SQLITE=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=megaseg
DB_USER=postgres
DB_PASSWORD=

# No configures DATABASE_URL para una instalación exclusivamente local.
