FLASK_ENV=development
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PASSWORD_RESET_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
SESSION_COOKIE_SECURE=false

# PostgreSQL local (no importa datos desde la base SQLite existente).
USE_POSTGRES=true
USE_SQLITE=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=megaseg
DB_USER=postgres
DB_PASSWORD=

# No configures DATABASE_URL para una instalación exclusivamente local.
RATELIMIT_STORAGE_URL=memory://
